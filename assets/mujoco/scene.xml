<mujoco model="basic_scene">
    <compiler angle="radian" coordinate="local"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <include file="panda.xml"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
        <material name="table_mat" rgba="0.8 0.6 0.4 1"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" type="plane" size="0 0 .05" material="grid" condim="3"/>
        <body name="table" pos="0.5 0 0.2">
            <geom type="box" size="0.3 0.3 0.2" material="table_mat" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
        </body>
        <!-- Pick object -->
        <body name="pick_object" pos="0.5 0.0 0.42">
            <freejoint name="pick_freejoint"/>
            <geom type="box" size="0.02 0.02 0.02" rgba="0.9 0.15 0.15 1" mass="0.05" friction="1.5 0.005 0.0001" condim="4"/>
        </body>
        <!-- Goal box-->
        <body name="goal_platform" pos="0.74 0.0 0.42">
            <!-- Base -->
            <geom type="box" size="0.05 0.05 0.002" pos="0 0 -0.018" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <!-- Side Walls -->
            <geom type="box" size="0.05 0.002 0.018" pos="0 -0.048 0.002" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <geom type="box" size="0.05 0.002 0.018" pos="0  0.048 0.002" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <!-- Front/Back Walls  -->
            <geom type="box" size="0.002 0.046 0.018" pos="-0.048 0 0.002" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <geom type="box" size="0.002 0.046 0.018" pos=" 0.048 0 0.002" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
        </body>

    </worldbody>
</mujoco>
