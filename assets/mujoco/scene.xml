<mujoco model="basic_scene">
    <compiler angle="radian" coordinate="local"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <include file="panda.xml"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
        <material name="table_mat" rgba="0.8 0.6 0.4 1"/>
        <material name="obstacle_mat" rgba="0.45 0.45 0.45 1"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" type="plane" size="0 0 .05" material="grid" condim="3"/>

        <!-- Low table, top surface at z=0.1 -->
        <body name="table" pos="0.5 0 0.05">
            <geom type="box" size="0.3 0.3 0.05" material="table_mat" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
        </body>

        <!-- Fixed center divider: object starts camera-side, goal starts beyond it. -->
        <body name="center_obstacle" pos="0.5 0 0.14">
            <geom name="center_obstacle_geom" type="box" size="0.28 0.012 0.04" material="obstacle_mat" contype="1" conaffinity="1" friction="1.2 0.01 0.0001"/>
        </body>

        <!-- Bottle-like pick object lying on its side (rotated 90deg around Y). -->
        <body name="pick_object" pos="0.4 -0.15 0.125" quat="0.7071 0.7071 0 0">
            <freejoint name="pick_freejoint"/>
            <geom name="bottle_base" type="box" size="0.025 0.025 0.05" pos="0 0 0" rgba="0.9 0.15 0.15 1" mass="0.03" friction="4.0 0.08 0.001" condim="4"/>
            <geom name="bottle_shoulder" type="sphere" size="0.014" pos="0 0 0.055" rgba="0.9 0.15 0.15 1" mass="0.01" friction="4.0 0.08 0.001" condim="4"/>
            <geom name="bottle_cap" type="cylinder" size="0.01 0.008" pos="0 0 0.075" rgba="0.08 0.08 0.08 1" mass="0.005" friction="3.0 0.05 0.001" condim="4"/>
        </body>

        <!-- Goal platform on table -->
        <body name="goal_platform" pos="0.5 0.15 0.1">
            <freejoint name="goal_freejoint"/>
            <geom type="box" size="0.10 0.10 0.002" pos="0 0 0.002" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <geom type="box" size="0.10 0.002 0.018" pos="0 -0.098 0.02" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <geom type="box" size="0.10 0.002 0.018" pos="0  0.098 0.02" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <geom type="box" size="0.002 0.096 0.018" pos="-0.098 0 0.02" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
            <geom type="box" size="0.002 0.096 0.018" pos=" 0.098 0 0.02" rgba="0.1 0.85 0.1 0.8" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
        </body>

        <camera name="perception_cam" pos="0.5 -0.7 0.7" xyaxes="1 0 0 0 0.5 0.866" fovy="60"/>

    </worldbody>
</mujoco>
